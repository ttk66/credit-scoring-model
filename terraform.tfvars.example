# Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your actual values from Yandex Cloud

# ============================================================================
# YANDEX CLOUD CREDENTIALS (получить в https://console.cloud.yandex.com)
# ============================================================================

# OAuth token для Yandex Cloud
# Получить: https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990511fc648e8a709&redirect_uri=https://oauth.yandex.ru/verification_code
yc_token = "YOUR_YANDEX_CLOUD_OAUTH_TOKEN_HERE"

# Yandex Cloud Cloud ID
# Найти: https://console.cloud.yandex.com/cloud?tab=overview (строка "Cloud ID")
yc_cloud_id = "b1g1234567890abcdefgh"

# Yandex Cloud Folder ID
# Найти: https://console.cloud.yandex.com/folders (выбрать нужную папку, скопировать ID)
yc_folder_id = "b1cdef1234567890abcde"

# Зона для ресурсов (доступные: ru-central1-a, ru-central1-b, ru-central1-c)
yc_zone = "ru-central1-a"

# ============================================================================
# OBJECT STORAGE (Remote State)
# ============================================================================

# Access Key для Object Storage (создается через Service Account)
# Получить:
#   1. Создать Service Account: yc iam service-account create --name terraform-sa
#   2. Дать права: yc resource-manager folder add-access-binding --role editor --subject serviceAccount:terraform-sa
#   3. Создать ключ: yc iam service-account create-access-key --service-account-name terraform-sa
yc_access_key = "YCAJEabcd1234567890"

# Secret Key для Object Storage
yc_secret_key = "YCPn1234567890abcdefghijklmnopqr"

# ============================================================================
# ============================================================================

# Получить после создания кластера:

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================

# Название проекта (используется для имен ресурсов)
project_name = "credit-scoring"

# Окружение (dev, staging, prod)
# Влияет на конфигурацию ресурсов (preemptible nodes, replication, etc)
environment = "dev"

# ============================================================================
# VPC CONFIGURATION
# ============================================================================

# CIDR блок для VPC сети
# Используется для 3-х подсетей в разных AZ
vpc_cidr = "10.0.0.0/16"

# ============================================================================
# KUBERNETES CONFIGURATION
# ============================================================================

# Версия Kubernetes (проверить доступные: yc managed-kubernetes list-versions)
k8s_version = "1.33"

# Количество узлов в node group
k8s_node_count = 3

# Тип диска для узлов (network-ssd рекомендуется)
k8s_node_disk_size = 50

# CPU cores для каждого узла
k8s_node_cpu = 4

# Память для каждого узла (GB)
k8s_node_memory = 8

# ============================================================================
# ДОПОЛНИТЕЛЬНО: Как получить значения из Yandex Cloud CLI
# ============================================================================

# 1. Установить YC CLI:
#    curl https://storage.yandexcloud.net/yandexcloud-release/install.sh | bash

# 2. Инициализировать:
#    yc init

# 3. Получить Cloud ID и Folder ID:
#    yc config list
#    yc resource-manager folders list

# 4. Получить OAuth token:
#    https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990511fc648e8a709&redirect_uri=https://oauth.yandex.ru/verification_code

# 5. Получить Access Key для Object Storage:
#    yc iam service-account create --name terraform-sa
#    yc iam service-account add-access-binding terraform-sa --role editor

# ============================================================================
# ВАЖНО: Никогда не коммитьте terraform.tfvars в git!
# Используйте .gitignore:
#   terraform.tfvars
#   terraform.tfvars.json
# ============================================================================
